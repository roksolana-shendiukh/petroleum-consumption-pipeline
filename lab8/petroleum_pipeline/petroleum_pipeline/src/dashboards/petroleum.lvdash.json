{
  "datasets": [
    {
      "name": "b9ae423f",
      "displayName": "consumption_monthly",
      "queryLines": [
        "SELECT d.full_date AS month_start,\n",
        "       p.product_name,\n",
        "       p.unit_code,\n",
        "       SUM(f.total_consumption) AS total_consumption\n",
        "FROM fct_snapshot_consumption_monthly f\n",
        "JOIN dim_date d ON f.dim_date_key = d.date_key\n",
        "JOIN dim_product p ON f.dim_product_key = p.product_key\n",
        "GROUP BY d.full_date, p.product_name, p.unit_code"
      ]
    },
    {
      "name": "f0b18206",
      "displayName": "prices_monthly",
      "queryLines": [
        "SELECT d.full_date AS month_start,\n",
        "       p.product_name,\n",
        "       AVG(f.avg_price) AS avg_price\n",
        "FROM fct_snapshot_prices_monthly f\n",
        "JOIN dim_date d ON f.dim_date_key = d.date_key\n",
        "JOIN dim_product p ON f.dim_product_key = p.product_key\n",
        "GROUP BY d.full_date, p.product_name"
      ]
    }
  ],
